# Copy to .env.local and fill in real values (.env.local is gitignored).

# Shared password for the dashboard gate (what users type on the login screen).
SGO_PASSWORD=

# Secret used to sign/encrypt the session cookie. MUST be at least 32 chars.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Persistent private directory, OUTSIDE the application and web root. Defaults
# to ~/.local/state/sgo-atlas. Share it between workers on a single Node host.
# SGO_STATE_DIR=/var/lib/sgo-atlas

# Leave unset unless your ingress OVERWRITES this single-IP header and blocks
# direct access to the Node server. Otherwise all visitors share one limit.
# SGO_TRUSTED_IP_HEADER=cf-connecting-ip
