# Copy to .env.local and fill in real values (.env.local is gitignored).

# Shared password for the dashboard gate (what users type on the login screen).
SGO_PASSWORD=change-me

# Secret used to sign/encrypt the session cookie. MUST be at least 32 chars.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-random-string-at-least-32-chars
