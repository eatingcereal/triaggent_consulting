Options -Indexes
DirectoryIndex index.html

# Deploy this file too: repository sources and local configuration are not web assets.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule (^|/)\.(?!well-known(?:/|$)) - [F,L]
    RewriteRule ^(?:sgo-next|scripts|components|tests)(?:/|$) - [F,L,NC]
    RewriteRule ^(?:index\.html)?$ - [E=TRIAGGENT_HOME:1]
</IfModule>

<FilesMatch "(?i)^(?:contact-config(?:\.local)?\.php(?:\..*)?|rate-limit\.php|security-headers\.php|.*\.(?:bak|old|orig|save|sql|sqlite(?:-wal|-shm)?|log|env|ini)|.*~)$">
    Require all denied
</FilesMatch>

<IfModule mod_headers.c>
    Header always set X-Frame-Options "DENY"
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "no-referrer"
    # Deliberately does not includeSubDomains: other applications have their own hosting.
    Header always set Strict-Transport-Security "max-age=31536000"

    # Portfolio exports include inline scripts, including the encrypted page's
    # decrypted document. Restrict their network destinations and embedding.
    <FilesMatch "\.html$">
        Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob:; connect-src 'self' blob:; media-src 'self' blob:; worker-src 'self' blob:; frame-src https://www.youtube.com https://www.youtube-nocookie.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests"
    # homepage-csp:start (generated by scripts/security_policy.py)
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' blob: 'unsafe-eval' 'sha256-66hbqoZbRiJsuSVmnxgzgIsNS0RceD9QtkyckRbTRLI=' 'sha256-GGztRNVTStRxOEtUK4PDs9i+ZGuBKgqFvX2vH4lryNQ=' 'sha256-JyaHhEBVNu1RAvHIfbgz58aVcJvSHz5yStasf9x4zl8='; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob:; connect-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-src 'none'; frame-ancestors 'none'; upgrade-insecure-requests" env=TRIAGGENT_HOME
    # homepage-csp:end
    </FilesMatch>
</IfModule>
